{
  "name": "budget-openrouter",
  "publisher": "alepiumetti",
  "displayName": "budget-openrouter",
  "description": "Para ver cuantos creditos me quedan en open router",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/alepiumetti/budget-openrouter.git"
  },
  "version": "1.0.3",
  "engines": {
    "vscode": "^1.115.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "budget-openrouter.refresh",
        "title": "OpenRouter: Refresh Budget"
      },
      {
        "command": "budget-openrouter.setApiKey",
        "title": "OpenRouter: Set API Key (Secure)"
      },
      {
        "command": "budget-openrouter.clearApiKey",
        "title": "OpenRouter: Clear Stored API Key"
      }
    ],
    "configuration": {
      "title": "Budget OpenRouter",
      "properties": {
        "budgetOpenrouter.apiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "(Fallback) OpenRouter API key usada para consultar uso y créditos restantes. Recomendado: usar el comando `OpenRouter: Set API Key (Secure)` o la variable de entorno OPENROUTER_API_KEY.",
          "markdownDeprecationMessage": "Configuración en texto plano. Usá el comando `OpenRouter: Set API Key (Secure)` para guardarla en Secret Storage de VS Code.",
          "ignoreSync": true,
          "scope": "application"
        },
        "budgetOpenrouter.refreshIntervalMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "markdownDescription": "Intervalo en minutos para el refresco automático de los datos de OpenRouter. Mínimo: 1 minuto.",
          "scope": "application"
        }
      }
    }
  },
  "scripts": {
    "prepare": "sh scripts/setup-git-hooks.sh",
    "bump:from-commits": "sh scripts/auto-bump-from-commits.sh",
    "pre-commit": "npm run bump:from-commits",
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.115.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "eslint": "^9.39.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
